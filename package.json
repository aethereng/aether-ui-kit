{
  "name": "@aether/ui-kit",
  "version": "0.4.0",
  "description": "Framework-free component cores with thin Vue wrappers, for engineering interfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "vue",
    "components",
    "design-system",
    "gantt",
    "graph",
    "timeline",
    "engineering"
  ],
  "exports": {
    "./property-editor": {
      "types": "./src/property-editor/vue/PropertyEditor.vue",
      "import": "./src/property-editor/vue/PropertyEditor.vue"
    },
    "./property-editor/core": {
      "types": "./src/property-editor/core/index.ts",
      "import": "./src/property-editor/core/index.ts"
    },
    "./controls/seg": {
      "types": "./src/controls/vue/Seg.vue",
      "import": "./src/controls/vue/Seg.vue"
    },
    "./controls/chip": {
      "types": "./src/controls/vue/Chip.vue",
      "import": "./src/controls/vue/Chip.vue"
    },
    "./controls/filter-rail": {
      "types": "./src/controls/vue/FilterRail.vue",
      "import": "./src/controls/vue/FilterRail.vue"
    },
    "./controls/search-field": {
      "types": "./src/controls/vue/SearchField.vue",
      "import": "./src/controls/vue/SearchField.vue"
    },
    "./controls/tool": {
      "types": "./src/controls/vue/Tool.vue",
      "import": "./src/controls/vue/Tool.vue"
    },
    "./controls/chat-panel": {
      "types": "./src/controls/vue/ChatPanel.vue",
      "import": "./src/controls/vue/ChatPanel.vue"
    },
    "./controls/toast": {
      "types": "./src/controls/vue/Toast.vue",
      "import": "./src/controls/vue/Toast.vue"
    },
    "./controls/transport": {
      "types": "./src/controls/vue/Transport.vue",
      "import": "./src/controls/vue/Transport.vue"
    },
    "./controls/core": {
      "types": "./src/controls/core/index.ts",
      "import": "./src/controls/core/index.ts"
    },
    "./viz/graph": {
      "types": "./src/viz/vue/Graph2D.vue",
      "import": "./src/viz/vue/Graph2D.vue"
    },
    "./viz/gantt": {
      "types": "./src/viz/vue/Gantt.vue",
      "import": "./src/viz/vue/Gantt.vue"
    },
    "./viz/core/gantt": {
      "types": "./src/viz/core/gantt.ts",
      "import": "./src/viz/core/gantt.ts"
    },
    "./viz/core": {
      "types": "./src/viz/core/index.ts",
      "import": "./src/viz/core/index.ts"
    },
    "./styles": {
      "types": "./src/styles/styles.d.ts",
      "import": "./src/styles/ui-kit.css"
    }
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vitest": "^3.1.1",
    "vue": "^3.5.38",
    "vue-tsc": "^2.2.8"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aethereng/aether-ui-kit.git"
  },
  "homepage": "https://github.com/aethereng/aether-ui-kit#readme",
  "bugs": {
    "url": "https://github.com/aethereng/aether-ui-kit/issues"
  },
  "author": "Aether Engineering",
  "sideEffects": [
    "*.css"
  ]
}
