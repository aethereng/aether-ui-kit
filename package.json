{
  "name": "@aether/ui-kit",
  "version": "0.1.0",
  "description": "Neutral, shared UI components for AetherOS, the Etere app, and the Quintus app -- framework-free core plus a thin wrapper per consumer. Home neutral to both engines, same reasoning as the determinism contract.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "ui",
    "components",
    "vue",
    "web-component",
    "custom-element",
    "property-editor"
  ],
  "exports": {
    "./property-editor": {
      "types": "./src/property-editor/vue/index.ts",
      "import": "./src/property-editor/vue/index.ts"
    },
    "./property-editor/core": {
      "types": "./src/property-editor/core/index.ts",
      "import": "./src/property-editor/core/index.ts"
    },
    "./property-editor/element": {
      "types": "./src/property-editor/element/index.ts",
      "import": "./src/property-editor/element/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^7.0.2",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "vite": "^8.0.16",
    "vitest": "^3.1.1",
    "vue": "^3.5.38",
    "vue-tsc": "^2.2.8"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
