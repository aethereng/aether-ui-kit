    "src",
    "!src/**/__tests__",
    "!src/**/*.test.ts",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "types": "vue-tsc -p tsconfig.build.json",
    "types:check": "vue-tsc -p tsconfig.build.json && git diff --exit-code -- \"*.d.ts\"",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "check:exports": "node scripts/check-exports.mjs",
    "tag:check": "node scripts/check-tag-version.mjs"
  },
