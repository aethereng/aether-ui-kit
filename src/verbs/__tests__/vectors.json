{
  "about": "Golden vectors for the verb machinery, written by hand from sections 4 and 11 of the definition and run against the toy vocabulary of toy.ts. A record is as 4.3 gives it. Its seq counts every record the store has written, undo and redo included, from 0. Its batch is the number of the step it belongs to, from 1, and a batch that is refused or changes nothing takes none. An undo or redo record is the original with before and after exchanged (and the op of an add and a remove exchanged with them), its seq renumbered. A remove carries the position the entity held among the ids of its kind, and the add that undoes it carries the same. A gesture replaces each of its moves by the next, so the step it ends as holds the records of its last move alone, numbered from the seq the gesture began at as if that move had run by itself, and a gesture that ends where it began takes no seq, no batch number and no log entry. The hashes of E1 are not here yet: a hash is named by a mark and compared with another.",
  "base": {
    "entities": {
      "box": {
        "b1": { "Name": "Alpha", "Dims": { "w": 10, "h": 20 } },
        "b2": { "Name": "Beta", "Dims": { "w": 30, "h": 40 } }
      },
      "label": {
        "l1": { "On": { "kind": "box", "id": "b1" }, "Text": "first" }
      }
    },
    "counters": { "box": 2, "label": 1 }
  },
  "vectors": [
    {
      "name": "three valid verbs are one undo step, and undo and redo return the hash",
      "section": "11.2",
      "steps": [
        { "do": "mark", "name": "start" },
        {
          "do": "run",
          "actor": "person",
          "calls": [
            { "verb": "box.rename", "input": { "id": "b1", "name": "A2" } },
            { "verb": "box.resize", "input": { "id": "b2", "w": 5 } },
            { "verb": "box.create", "input": { "name": "Gamma", "w": 10, "h": 10 }, "as": "g" }
          ],
          "expect": {
            "ok": true, "changed": true, "batch": 1, "ids": { "g": "b3" },
            "records": [
              { "seq": 0, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "Alpha", "after": "A2" },
              { "seq": 1, "batch": 1, "verb": "box.resize", "cause": "box.resize", "op": "set", "kind": "box", "id": "b2", "component": "Dims", "field": "w", "before": 30, "after": 5 },
              { "seq": 2, "batch": 1, "verb": "box.create", "cause": "box.create", "op": "add", "kind": "box", "id": "b3", "after": { "Name": "Gamma", "Dims": { "w": 10, "h": 10 } } }
            ]
          },
          "after": { "undoDepth": 1, "redoDepth": 0, "log": 3, "ids": { "box": ["b1", "b2", "b3"] }, "hash": { "differs": "start", "mark": "after" } }
        },
        {
          "do": "undo",
          "expect": {
            "ok": true, "changed": true, "batch": 1,
            "records": [
              { "seq": 3, "batch": 1, "verb": "box.create", "cause": "box.create", "op": "remove", "kind": "box", "id": "b3", "before": { "Name": "Gamma", "Dims": { "w": 10, "h": 10 } } },
              { "seq": 4, "batch": 1, "verb": "box.resize", "cause": "box.resize", "op": "set", "kind": "box", "id": "b2", "component": "Dims", "field": "w", "before": 5, "after": 30 },
              { "seq": 5, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "A2", "after": "Alpha" }
            ]
          },
          "after": { "undoDepth": 0, "redoDepth": 1, "log": 4, "ids": { "box": ["b1", "b2"] }, "hash": { "equals": "start" } }
        },
        {
          "do": "redo",
          "expect": {
            "ok": true, "changed": true, "batch": 1,
            "records": [
              { "seq": 6, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "Alpha", "after": "A2" },
              { "seq": 7, "batch": 1, "verb": "box.resize", "cause": "box.resize", "op": "set", "kind": "box", "id": "b2", "component": "Dims", "field": "w", "before": 30, "after": 5 },
              { "seq": 8, "batch": 1, "verb": "box.create", "cause": "box.create", "op": "add", "kind": "box", "id": "b3", "after": { "Name": "Gamma", "Dims": { "w": 10, "h": 10 } } }
            ]
          },
          "after": { "undoDepth": 1, "redoDepth": 0, "log": 5, "ids": { "box": ["b1", "b2", "b3"] }, "hash": { "equals": "after" } }
        }
      ]
    },
    {
      "name": "a batch whose third verb is invalid changes the store, the stack and the log by nothing",
      "section": "11.2",
      "steps": [
        { "do": "mark", "name": "start" },
        {
          "do": "run",
          "actor": "person",
          "calls": [
            { "verb": "box.rename", "input": { "id": "b1", "name": "A2" } },
            { "verb": "box.create", "input": { "name": "Gamma", "w": 10, "h": 10 }, "as": "g" },
            { "verb": "box.resize", "input": { "id": "b2", "w": 500 } }
          ],
          "expect": { "ok": false, "reason": "input", "at": 2, "message": "/w is above 100" },
          "after": { "undoDepth": 0, "redoDepth": 0, "log": 0, "ids": { "box": ["b1", "b2"] }, "hash": { "equals": "start" } }
        }
      ]
    },
    {
      "name": "an input that changes nothing leaves no step, no batch number and no log entry",
      "section": "11.2",
      "steps": [
        { "do": "mark", "name": "start" },
        {
          "do": "run",
          "actor": "person",
          "calls": [
            { "verb": "box.rename", "input": { "id": "b1", "name": "Alpha" } },
            { "verb": "box.resize", "input": { "id": "b2", "w": 30, "h": 40 } }
          ],
          "expect": { "ok": true, "changed": false, "noBatch": true, "records": [] },
          "after": { "undoDepth": 0, "redoDepth": 0, "log": 0, "hash": { "equals": "start" } }
        },
        {
          "do": "run",
          "actor": "person",
          "calls": [{ "verb": "box.rename", "input": { "id": "b1", "name": "X" } }],
          "expect": {
            "ok": true, "changed": true, "batch": 1,
            "records": [
              { "seq": 0, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "Alpha", "after": "X" }
            ]
          },
          "after": { "undoDepth": 1, "log": 1 }
        }
      ]
    },
    {
      "name": "a batch whose writes cancel is no change, and the redo tail stays",
      "section": "11.2",
      "steps": [
        {
          "do": "run",
          "actor": "person",
          "calls": [{ "verb": "box.rename", "input": { "id": "b1", "name": "X" } }],
          "expect": {
            "ok": true, "changed": true, "batch": 1,
            "records": [
              { "seq": 0, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "Alpha", "after": "X" }
            ]
          },
          "after": { "undoDepth": 1, "redoDepth": 0, "log": 1, "hash": { "mark": "x" } }
        },
        {
          "do": "undo",
          "expect": {
            "ok": true, "changed": true, "batch": 1,
            "records": [
              { "seq": 1, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "X", "after": "Alpha" }
            ]
          },
          "after": { "undoDepth": 0, "redoDepth": 1, "log": 2, "hash": { "mark": "base" } }
        },
        {
          "do": "run",
          "actor": "person",
          "calls": [
            { "verb": "box.rename", "input": { "id": "b1", "name": "Z" } },
            { "verb": "box.rename", "input": { "id": "b1", "name": "Alpha" } }
          ],
          "expect": { "ok": true, "changed": false, "noBatch": true, "records": [] },
          "after": { "undoDepth": 0, "redoDepth": 1, "log": 2, "hash": { "equals": "base" } }
        },
        {
          "do": "redo",
          "expect": {
            "ok": true, "changed": true, "batch": 1,
            "records": [
              { "seq": 2, "batch": 1, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "Alpha", "after": "X" }
            ]
          },
          "after": { "undoDepth": 1, "redoDepth": 0, "log": 3, "hash": { "equals": "x" } }
        },
        {
          "do": "run",
          "actor": "person",
          "calls": [{ "verb": "box.rename", "input": { "id": "b1", "name": "Y" } }],
          "expect": {
            "ok": true, "changed": true, "batch": 2,
            "records": [
              { "seq": 3, "batch": 2, "verb": "box.rename", "cause": "box.rename", "op": "set", "kind": "box", "id": "b1", "component": "Name", "before": "X", "after": "Y" }
            ]
          }
        }
      ]
    },
    {
      "name": "a resize and its reverse on a box a label sits on is no change, and the system that marks the label stale does not run",
      "section": "4.2",
      "steps": [
        { "do": "mark", "name": "start" },
        {
          "do": "run",
          "actor": "person",
          "calls": [
            { "verb": "box.resize", "input": { "id": "b1", "w": 11 } },
            { "verb": "box.resize", "input": { "id": "b1", "w": 10 } }
          ],
          "expect": { "ok": true, "changed": false, "noBatch": true, "records": [] },
          "after": { "undoDepth": 0, "redoDepth": 0, "log": 0, "hash": { "equals": "start" } }
        },
        {
          "do": "run",
          "actor": "person",
          "calls": [{ "verb": "box.resize", "input": { "id": "b1", "w": 11 } }],
          "expect": {
            "ok": true,
            "changed": true,
            "batch": 1,
            "records": [
              { "seq": 0, "batch": 1, "verb": "box.resize", "cause": "box.resize", "op": "set", "kind": "box", "id": "b1", "component": "Dims", "field": "w", "before": 10, "after": 11 },
              { "seq": 1, "batch": 1, "verb": "box.resize", "cause": "system:stale", "op": "set", "kind": "label", "id": "l1", "component": "Stale", "after": true }
            ]
          },
          "after": { "undoDepth": 1, "log": 1 }
        }
      ]
    },
    {
      "name": "a drag of five moves is one undo step and one log entry, numbered as its last move alone",
      "section": "4.5",
      "steps": [
        { "do": "mark", "name": "start" },
        {
          "do": "gesture",
          "actor": "person",
          "moves": [
            { "calls": [{ "verb": "box.resize", "input": { "id": "b1", "w": 11 } }] },
            { "calls": [{ "verb": "box.resize", "input": { "id": "b1", "w": 12 } }] },
            { "calls": [{ "verb": "box.resize", "input": { "id": "b1", "w": 13 } }] },
            { "calls": [{ "verb": "box.resize", "input": { "id": "b1", "w": 14 } }] },
            { "calls": [{ "verb": "box.resize", "input": { "id": "b1", "w": 15 } }] }
          ],
          "finish": "end",
          "expect": {
            "ok": true,
            "changed": true,
            "batch": 1,
            "records": [
              { "seq": 0, "batch": 1, "verb": "box.resize", "cause": "box.resize", "op": "set", "kind": "box", "id": "b1", "component": "Dims", "field": "w", "before": 10, "after": 15 },
              { "seq": 1, "batch": 1, "verb": "box.resize", "cause": "system:stale", "op": "set", "kind": "label", "id": "l1", "component": "Stale", "after": true }
            ]
          },
          "after": {
            "undoDepth": 1,
            "redoDepth": 0,
            "log": 1,
            "logTail": [{ "verb": "box.resize", "input": { "id": "b1", "w": 15 }, "actor": "person" }],
            "hash": { "differs": "start", "mark": "end" }
          }
        },
        {
          "do": "undo",
          "expect": {
            "ok": true,
            "changed": true,
            "batch": 1,
            "records": [
              { "seq": 2, "batch": 1, "verb": "box.resize", "cause": "system:stale", "op": "set", "kind": "label", "id": "l1", "component": "Stale", "before": true },
              { "seq": 3, "batch": 1, "verb": "box.resize", "cause": "box.resize", "op": "set", "kind": "box", "id": "b1", "component": "Dims", "field": "w", "before": 15, "after": 10 }
            ]
          },
          "after": { "undoDepth": 0, "redoDepth": 1, "log": 2, "hash": { "equals": "start" } }
        },
        { "do": "redo", "expect": { "ok": true, "changed": true, "batch": 1 }, "after": { "undoDepth": 1, "redoDepth": 0, "log": 3, "hash": { "equals": "end" } } },
        { "do": "replay" }
      ]
    },
    {
